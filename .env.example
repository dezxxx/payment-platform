# Copy to .env and adjust. .env itself is never committed.
#
# Every image tag is pinned here rather than written into docker-compose.yml,
# so the whole local stack is reproducible and upgrades are a deliberate edit
# in one file instead of a silent "latest" drift.

# --- Image tags ---
POSTGRES_IMAGE=postgres:18.2
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2
PROMETHEUS_IMAGE=prom/prometheus:v3.11.0
TEMPO_IMAGE=grafana/tempo:2.10.0
GRAFANA_IMAGE=grafana/grafana:12.4.0

# --- Host ports (see the port map in CONTEXT.md) ---
KEYCLOAK_POSTGRES_PORT=5433
KEYCLOAK_PORT=8080
INDIVIDUALS_API_PORT=8081
PERSON_POSTGRES_PORT=5434
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
GRAFANA_PORT=3000

# --- Keycloak ---
# KC_BOOTSTRAP_ADMIN_* replaced KEYCLOAK_ADMIN_* in Keycloak 26.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=payment-platform
# Confidential client individuals-api uses against the Admin REST API and the
# token endpoint. The secret must match the one in realm-export.json.
KEYCLOAK_CLIENT_ID=individuals-api
KEYCLOAK_CLIENT_SECRET=change-me

# --- Keycloak database ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# --- person-service database (migrations only in module 1) ---
PERSON_DB_NAME=person
PERSON_DB_USER=person
PERSON_DB_PASSWORD=person

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
