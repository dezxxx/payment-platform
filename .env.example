# Copy to .env and adjust. .env itself is never committed.

# --- Image tags ---
POSTGRES_IMAGE=postgres:18.2
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2
PROMETHEUS_IMAGE=prom/prometheus:v3.11.0
TEMPO_IMAGE=grafana/tempo:2.10.0
LOKI_IMAGE=grafana/loki:3.6.1
ALLOY_IMAGE=grafana/alloy:v1.13.1
GRAFANA_IMAGE=grafana/grafana:12.4.0

# --- Host ports (see the port map in CONTEXT.md) ---
KEYCLOAK_POSTGRES_PORT=5433
KEYCLOAK_PORT=8080
INDIVIDUALS_API_PORT=8081
PERSON_POSTGRES_PORT=5434
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3000
PERSON_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8084
TRANSACTION_POSTGRES_0_PORT=5435
TRANSACTION_POSTGRES_1_PORT=5436

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=payment-platform
# the secret must match the one in realm-export.json
KEYCLOAK_CLIENT_ID=individuals-api
KEYCLOAK_CLIENT_SECRET=change-me

# --- Keycloak database ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# --- person-service database ---
PERSON_DB_NAME=person
PERSON_DB_USER=person
PERSON_DB_PASSWORD=person

# --- transaction-service databases: both shards ---
TRANSACTION_DB_NAME=transaction
TRANSACTION_DB_USER=transaction
TRANSACTION_DB_PASSWORD=transaction

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Nexus ---
NEXUS_IMAGE=sonatype/nexus3:3.96.1
NEXUS_PORT=8083
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=admin123

# --- person-service ---
# set only to point individuals-api at another person-service
# PERSON_SERVICE_URL=http://person-service:8082
