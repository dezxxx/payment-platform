@startuml container
!include <C4/C4_Container>

title currency-rate-service — container diagram (C4, level 2)

Person(client, "Client", "Transfers between wallets of different currencies")

Container_Ext(individualsApi, "individuals-api", "Spring Boot WebFlux", "The only external entry point")
Container_Ext(transactionService, "transaction-service", "Spring Boot MVC", "Takes the rate on transfer init and puts it into the signed offer")
Container_Ext(keycloak, "Keycloak", "identity provider", "Service tokens, signing keys (JWKS)")

System_Boundary(crs, "currency-rate-service") {
    Container(app, "currency-rate-service", "Spring Boot MVC, Java 25", "Updates the rates on schedule (ShedLock), applies correction coefficients, answers with the rate of a pair")
    ContainerDb(db, "PostgreSQL currency-postgres", "currencies, rate_providers, rate_corrections, conversion_rates, shedlock", "Own database of the service")
}

System_Ext(externalApi, "External rate API", "Latest exchange rates of all currencies")
Container_Ext(observability, "Prometheus, Loki, Tempo, Grafana", "observability", "Metrics, JSON logs, traces")

Rel(client, individualsApi, "POST /api/v1/transactions/transfer/init", "HTTPS, JWT")
Rel(individualsApi, transactionService, "transfer/init", "REST, service token")
Rel(individualsApi, keycloak, "service token, the only Keycloak client", "client_credentials, cached")
Rel(transactionService, app, "GET /api/v1/rates?from&to", "REST, the incoming service token passed on")
Rel(app, keycloak, "keys to check the service token", "JWKS, cached")
Rel(app, externalApi, "latest rates, on schedule", "HTTPS, API key from .env")
Rel(app, db, "reads and writes", "JDBC, Flyway")
Rel(app, observability, "/actuator/prometheus, logs, traces")
@enduml
