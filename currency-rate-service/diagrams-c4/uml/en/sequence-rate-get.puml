@startuml sequence-rate-get
title Rate of a pair
skinparam maxMessageSize 220
skinparam responseMessageBelowArrow true

participant "transaction-service" as TS
participant "SecurityConfig" as Sec
participant "GlobalExceptionHandler" as Err
participant "CurrencyRateController" as Ctl
participant "ExchangeRateService" as S
database "DB" as DB

TS -> Sec: GET /api/v1/rates?from=USD&to=EUR[&timestamp], Bearer service token
alt no token, bad signature or expired
    Sec -> Err: AuthenticationException
    Err --> TS: 401 AUTHENTICATION_REQUIRED
else valid token without the realm role SERVICE
    Sec -> Err: AccessDeniedException
    Err --> TS: 403 ACCESS_DENIED
else allowed
    Sec -> Ctl
    alt from or to is not 3 capital letters, from = to, timestamp is not ISO 8601
        Ctl -> Err: validation error
        Err --> TS: 400 VALIDATION_ERROR
    else valid
        Ctl -> S: getRate(from, to, timestamp or now)
        S -> DB: the newest rate of the pair where rate_begin_time <= timestamp < rate_end_time
        alt no such rate (unknown pair or rates are stale)
            S -> Err: RateNotFoundException
            Err --> TS: 404 RATE_NOT_FOUND
        else found
            S --> TS: 200 sourceCode, destinationCode, rate, rateTimestamp, providerCode
        end
    end
end
note over Sec, DB
  401 / 403 / 400: nothing is read; the service never writes on this path.
  GET /api/v1/currencies and GET /api/v1/rate-providers: the same token check, then a read of the table, 200 with the list.
end note
@enduml
