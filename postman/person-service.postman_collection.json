{
  "info": {
    "name": "person-service",
    "description": "Every endpoint of person-service and every error it answers with, for one individual, Ivan Petrov.\n\nNothing is copied by hand: the create request stores the individual id and the next requests use it. Run the whole collection with Postman's Runner, top to bottom. Every run makes a fresh email, so the collection can be run again on the same database: the individual is soft deleted at the end and its archived row stays.\n\nbaseUrl is http://localhost:8082 - person-service in docker compose (make up). Started from the IDE instead, it runs on 8092 while compose holds 8082: change baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "emailUpper",
      "value": ""
    },
    {
      "key": "emailMixed",
      "value": ""
    },
    {
      "key": "individualId",
      "value": ""
    },
    {
      "key": "compensatedEmail",
      "value": ""
    },
    {
      "key": "compensatedId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Infrastructure",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "Swagger UI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/swagger-ui/index.html"
          }
        },
        {
          "name": "Contract served to Swagger UI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('our contract', () => pm.expect(pm.response.text()).to.include('/api/v1/individuals'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi/person-service.yaml"
          }
        }
      ]
    },
    {
      "name": "1. Ivan - the whole life of an individual",
      "item": [
        {
          "name": "Create individual",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `ivan.petrov.${Date.now()}@example.org`;",
                  "pm.collectionVariables.set('email', email);",
                  "pm.collectionVariables.set('emailUpper', email.replace('ivan.petrov', 'IVAN.Petrov'));",
                  "pm.collectionVariables.set('emailMixed', email.replace('ivan.petrov', 'Ivan.PETROV'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const i = pm.response.json();",
                  "pm.collectionVariables.set('individualId', i.id);",
                  "pm.test('individual id is a UUID', () => pm.expect(i.id).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.test('individual on top, user inside', () => { pm.expect(i.user).to.be.an('object'); pm.expect(i.user.id).to.not.eql(i.id); });",
                  "pm.test('status NEW', () => pm.expect(i.status).to.eql('NEW'));",
                  "pm.test('passport and phone as sent', () => { pm.expect(i.passportNumber).to.eql('123456789'); pm.expect(i.phoneNumber).to.eql('+380441234567'); });",
                  "pm.test('email as sent', () => pm.expect(i.user.email).to.eql(pm.collectionVariables.get('email')));",
                  "pm.test('filled', () => pm.expect(i.user.filled).to.eql(true));",
                  "pm.test('country resolved', () => { pm.expect(i.user.address.countryAlpha3).to.eql('UKR'); pm.expect(i.user.address.countryAlpha2).to.eql('UA'); });",
                  "pm.test('createdAt present, in UTC', () => pm.expect(i.user.createdAt).to.match(/Z$/));",
                  "pm.test('createdAt is now, not shifted by a time zone', () => pm.expect(Math.abs(Date.now() - Date.parse(i.user.createdAt))).to.be.below(60000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/individuals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passportNumber\": \"123456789\",\n  \"phoneNumber\": \"+380441234567\",\n  \"user\": {\n    \"email\": \"{{email}}\",\n    \"firstName\": \"Ivan\",\n    \"lastName\": \"Petrov\",\n    \"address\": {\n      \"countryAlpha3\": \"UKR\",\n      \"countryAlpha2\": \"UA\",\n      \"city\": \"Kyiv\",\n      \"state\": \"Kyiv\",\n      \"zipCode\": \"01001\",\n      \"addressLine\": \"1 Example St.\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Get by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the same individual', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('individualId')));",
                  "pm.test('aggregate whole', () => { const i = pm.response.json(); pm.expect(i.user).to.be.an('object'); pm.expect(i.user.address).to.be.an('object'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/individuals/{{individualId}}"
          }
        },
        {
          "name": "Get by email, other letter case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('email is case-insensitive', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('individualId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/individuals/by-email?email={{emailUpper}}"
          }
        },
        {
          "name": "Update individual, user and address in one request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const i = pm.response.json();",
                  "pm.test('individual changed', () => pm.expect(i.phoneNumber).to.eql('+380441234568'));",
                  "pm.test('user changed', () => pm.expect(i.user.lastName).to.eql('Petrov-Senior'));",
                  "pm.test('address changed', () => pm.expect(i.user.address.city).to.eql('Lviv'));",
                  "pm.test('the rest kept (PATCH)', () => { pm.expect(i.passportNumber).to.eql('123456789'); pm.expect(i.user.firstName).to.eql('Ivan'); pm.expect(i.user.address.zipCode).to.eql('01001'); });",
                  "pm.test('updatedAt moved on', () => pm.expect(Date.parse(i.user.updatedAt)).to.be.above(Date.parse(i.user.createdAt)));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/individuals/{{individualId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+380441234568\",\n  \"user\": {\n    \"lastName\": \"Petrov-Senior\",\n    \"address\": {\n      \"city\": \"Lviv\"\n    }\n  }\n}"
            }
          }
        }
      ]
    },
