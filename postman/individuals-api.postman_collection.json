{
  "info": {
    "name": "individuals-api",
    "description": "Every endpoint of individuals-api for two users, Ivan and Anna, so each one can be checked on its own afterwards: in Keycloak (admin console, realm payment-platform, Users) and through /me with that user's token.\n\nNothing is copied by hand: every request stores what the next one needs in collection variables. Run the whole collection with Postman's Runner, top to bottom.\n\nRun it on a fresh stack (make up after the volumes were removed). The emails are fixed so the users are easy to find; a second run on the same stack answers 409 on registration, which is correct.\n\nperson-service is a WireMock stub in module 1 (infra/person-service-stub): it gives every registration a new userUid and answers 409 to a second registration of Ivan or Anna.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "password", "value": "Str0ngPass!", "description": "The same for both users, to keep the collection short." },

    { "key": "ivanEmail", "value": "ivan.petrov@example.com" },
    { "key": "ivanAccessToken", "value": "" },
    { "key": "ivanRefreshToken", "value": "" },
    { "key": "ivanUserUid", "value": "" },

    { "key": "annaEmail", "value": "anna.smirnova@example.com" },
    { "key": "annaAccessToken", "value": "" },
    { "key": "annaRefreshToken", "value": "" },
    { "key": "annaUserUid", "value": "" }
  ],
  "item": [
    {
      "name": "0. Infrastructure",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Swagger UI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the Swagger UI page', () => pm.expect(pm.response.text()).to.include('swagger-ui'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/swagger-ui.html", "host": ["{{baseUrl}}"], "path": ["swagger-ui.html"] },
            "description": "Open it in a browser: http://localhost:8081/swagger-ui.html"
          }
        },
        {
          "name": "Swagger shows our contract",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const config = pm.response.json();",
                  "pm.test('the UI loads openapi/individuals-api.yaml, not a spec guessed from the code', () => {",
                  "    pm.expect(config.url).to.eql('/openapi/individuals-api.yaml');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v3/api-docs/swagger-config", "host": ["{{baseUrl}}"], "path": ["v3", "api-docs", "swagger-config"] }
          }
        },
        {
          "name": "Contract file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const spec = pm.response.text();",
                  "pm.test('is our contract with all four paths', () => {",
                  "    pm.expect(spec).to.include('title: individuals-api');",
                  "    ['/api/v1/auth/registration', '/api/v1/auth/login', '/api/v1/auth/refresh-token', '/api/v1/auth/me']",
                  "        .forEach(path => pm.expect(spec).to.include(path));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/openapi/individuals-api.yaml", "host": ["{{baseUrl}}"], "path": ["openapi", "individuals-api.yaml"] }
          }
        }
      ]
    },
    {
      "name": "1. Ivan",
      "item": [
        {
          "name": "Register Ivan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('both tokens and the userUid', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.userUid).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "    pm.expect(body.expiresIn).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('ivanAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('ivanRefreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('ivanUserUid', body.userUid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/registration", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "registration"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ivanEmail}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\"\n}"
            },
            "description": "person-service gives the userUid, Keycloak creates the account, then the user is logged in - tokens come back at once. 201 (Created)."
          }
        },
        {
          "name": "Ivan - who am I",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is Ivan', () => {",
                  "    pm.expect(body.userUid).to.eql(pm.collectionVariables.get('ivanUserUid'));",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('ivanEmail'));",
                  "    pm.expect(body.firstName).to.eql('Ivan');",
                  "    pm.expect(body.lastName).to.eql('Petrov');",
                  "});",
                  "pm.test('has the platform role, none of Keycloak own', () => {",
                  "    pm.expect(body.roles).to.include('USER');",
                  "    pm.expect(body.roles).to.not.include('offline_access');",
                  "});",
                  "pm.test('registeredAt is filled', () => pm.expect(body.registeredAt).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ivanAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Ivan - refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('a fresh pair, still Ivan', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.userUid).to.eql(pm.collectionVariables.get('ivanUserUid'));",
                  "});",
                  "pm.collectionVariables.set('ivanAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('ivanRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh-token"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{ivanRefreshToken}}\"\n}" }
          }
        },
        {
          "name": "Ivan - login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('the same userUid as at registration', () => {",
                  "    pm.expect(body.userUid).to.eql(pm.collectionVariables.get('ivanUserUid'));",
                  "});",
                  "pm.collectionVariables.set('ivanAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('ivanRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{ivanEmail}}\",\n  \"password\": \"{{password}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Anna",
      "item": [
        {
          "name": "Register Anna",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('both tokens and the userUid', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.userUid).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('a userUid of her own, not Ivan\\'s', () => {",
                  "    pm.expect(body.userUid).to.not.eql(pm.collectionVariables.get('ivanUserUid'));",
                  "});",
                  "pm.collectionVariables.set('annaAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('annaRefreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('annaUserUid', body.userUid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/registration", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "registration"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{annaEmail}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"firstName\": \"Anna\",\n  \"lastName\": \"Smirnova\"\n}"
            }
          }
        },
        {
          "name": "Anna - who am I",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is Anna', () => {",
                  "    pm.expect(body.userUid).to.eql(pm.collectionVariables.get('annaUserUid'));",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('annaEmail'));",
                  "    pm.expect(body.firstName).to.eql('Anna');",
                  "    pm.expect(body.lastName).to.eql('Smirnova');",
                  "});",
                  "pm.test('has the platform role', () => pm.expect(body.roles).to.include('USER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{annaAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Anna - refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('a fresh pair, still Anna', () => {",
                  "    pm.expect(body.userUid).to.eql(pm.collectionVariables.get('annaUserUid'));",
                  "});",
                  "pm.collectionVariables.set('annaAccessToken', body.accessToken);",
                  "pm.collectionVariables.set('annaRefreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh-token"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{annaRefreshToken}}\"\n}" }
          }
        },
        {
          "name": "Anna - login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the same userUid as at registration', () => {",
                  "    pm.expect(pm.response.json().userUid).to.eql(pm.collectionVariables.get('annaUserUid'));",
                  "});",
                  "pm.collectionVariables.set('annaAccessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('annaRefreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{annaEmail}}\",\n  \"password\": \"{{password}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Each token is its own user",
      "item": [
        {
          "name": "Ivan's token still gives Ivan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Ivan, not the last one who logged in', () => {",
                  "    pm.expect(pm.response.json().userUid).to.eql(pm.collectionVariables.get('ivanUserUid'));",
                  "    pm.expect(pm.response.json().userUid).to.not.eql(pm.collectionVariables.get('annaUserUid'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ivanAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "4. Failures",
      "description": "Every error has the same shape: timestamp, path, status, error, message, traceId, details.",
      "item": [
        {
          "name": "Register - confirmation does not match (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('VALIDATION_ERROR on confirmPassword', () => {",
                  "    pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                  "    pm.expect(body.details.join(' ')).to.include('confirmPassword');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/registration", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "registration"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mismatch@example.com\",\n  \"password\": \"Str0ngPass!\",\n  \"confirmPassword\": \"Different1!\",\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\"\n}"
            }
          }
        },
        {
          "name": "Register Ivan again (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('USER_ALREADY_EXISTS', () => pm.expect(pm.response.json().error).to.eql('USER_ALREADY_EXISTS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/registration", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "registration"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ivanEmail}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\"\n}"
            },
            "description": "person-service refuses first, so nothing is created in Keycloak."
          }
        },
        {
          "name": "Login - wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('INVALID_CREDENTIALS', () => pm.expect(pm.response.json().error).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{annaEmail}}\",\n  \"password\": \"WrongPassword1!\"\n}" },
            "description": "Keycloak answers 400 invalid_grant; we answer 401 - the caller is wrong, not us."
          }
        },
        {
          "name": "Refresh - broken refresh token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('REFRESH_TOKEN_INVALID, not a wrong password', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('REFRESH_TOKEN_INVALID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh-token"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"not-a-real-token\"\n}" }
          }
        },
        {
          "name": "Who am I - no token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('our error shape, even from the security filter', () => {",
                  "    pm.expect(body).to.have.all.keys('timestamp', 'path', 'status', 'error', 'message', 'traceId', 'details');",
                  "});",
                  "pm.test('AUTHENTICATION_REQUIRED', () => pm.expect(body.error).to.eql('AUTHENTICATION_REQUIRED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Who am I - forged token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('AUTHENTICATION_REQUIRED', () => pm.expect(pm.response.json().error).to.eql('AUTHENTICATION_REQUIRED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not.a.jwt" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "5. Metrics",
      "item": [
        {
          "name": "Prometheus metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const scrape = pm.response.text();",
                  "[",
                  "    'auth_registration_total',",
                  "    'auth_registration_success_total',",
                  "    'auth_registration_failure_total',",
                  "    'auth_login_total',",
                  "    'auth_login_failure_total',",
                  "    'auth_refresh_total',",
                  "    'external_keycloak_requests_seconds_count',",
                  "    'external_person_service_requests_seconds_count'",
                  "].forEach(meter => {",
                  "    pm.test(meter + ' is published', () => pm.expect(scrape).to.include(meter));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/prometheus", "host": ["{{baseUrl}}"], "path": ["actuator", "prometheus"] }
          }
        }
      ]
    }
  ]
}
