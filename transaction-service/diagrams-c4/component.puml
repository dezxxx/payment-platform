@startuml component
!include <C4/C4_Component>

title transaction-service — component diagram (C4, level 3)

Container_Ext(individualsApi, "individuals-api", "Spring Boot WebFlux", "Calls transaction-service through transaction-service-client, user_uid from the token")
ContainerDb(shard0, "PostgreSQL shard_0", "wallets, transactions, outbox_events", "hash(user_uid) % 2 = 0")
ContainerDb(shard1, "PostgreSQL shard_1", "wallets, transactions, outbox_events", "hash(user_uid) % 2 = 1")
Container_Ext(keycloak, "Keycloak", "identity provider", "Realm signing keys (JWKS)")
Container_Ext(kafka, "Kafka", "KRaft", "deposit / withdrawal events")
Container_Ext(schemaRegistry, "Schema Registry", "Confluent", "Avro schemas of the events")
Container_Ext(observability, "Prometheus / Alloy", "metrics, traces, logs", "Observability stack")

Container_Boundary(app, "transaction-service") {
    Component(security, "SecurityConfig", "Spring Security resource server", "Every request except actuator, OpenAPI and Swagger UI: Bearer token signed by the realm keys with the realm role SERVICE; otherwise 401 / 403 through GlobalExceptionHandler, nothing read or written")
    Component(walletController, "WalletRestControllerV1", "Spring MVC, implements the generated WalletsApi", "/api/v1/wallets: create, wallet by id, a user's wallets")
    Component(transactionController, "TransactionRestControllerV1", "Spring MVC, implements the generated TransactionsApi", "/api/v1/transactions: init, confirm, status, search")
    Component(handler, "GlobalExceptionHandler", "@RestControllerAdvice", "Answers any error in RFC 9457 form")
    Component(transactionService, "TransactionService", "Spring service, @Transactional", "init computes the terms without writing and issues a signed offerToken (5 min); confirm checks the token, claims its requestId, rejects an expired offer, then in one transaction: re-checks, transaction, event with traceparent; finalize in one transaction: status only from PENDING, then the balance")
    Component(signer, "OfferTokenSigner", "HMAC-SHA256, secret from .env", "issue: terms -> signed offerToken; readVerified: offerToken -> terms only if format and signature are valid")
    Component(offerValidator, "OfferTokenValidator", "validation", "One validate: signature (via OfferTokenSigner), owner = X-User-Uid, operation type")
    Component(validators, "DifferentWalletsValidator, DateRangeValidator", "validation", "Transfer between two different wallets (@Valid on the body); search dateFrom not after dateTo")
    Component(metrics, "TransactionMetrics, ShardPoolMetrics", "Micrometer", "Unsent events and their age, PENDING transactions, send failures, DLT; connection pools of both shards")
    Component(migrations, "ShardMigrations", "Flyway", "Migrates each shard directly before the DataSource starts")
    Component(walletService, "WalletService", "Spring service", "Wallet checks, Debit / Credit under a FOR NO KEY UPDATE lock")
    Component(mappers, "WalletMapper, TransactionMapper", "manual mapping", "Generated DTOs <-> entities")
    Component(repositories, "WalletRepository, WalletTypeRepository, TransactionRepository, OutboxEventRepository", "Spring Data JPA", "Wallets, wallet types, transactions, the outbox")
    Component(sharding, "ShardingSphere-JDBC", "JDBC driver", "Routes SQL to the shard by user_uid")
    Component(publisher, "TransactionKafkaProducer", "@Scheduled, KafkaTemplate, Avro", "Outbox relay: sends unsent rows of outbox_events to Kafka with traceparent; marks a row sent only after the broker acknowledges, retries on failure")
    Component(consumer, "TransactionKafkaConsumer", "@KafkaListener, Avro", "Receives *Completed / *Failed and hands them to TransactionService; a repeat changes 0 rows (WHERE status = PENDING); failure -> retry -> DLT")
}

Rel(individualsApi, security, "every request", "HTTP, JSON, Bearer service token")
Rel(security, keycloak, "realm keys", "JWKS, cached")
Rel(security, handler, "401 AUTHENTICATION_REQUIRED, 403 ACCESS_DENIED")
Rel(security, walletController, "REST /api/v1/wallets, role SERVICE")
Rel(security, transactionController, "REST /api/v1/transactions, role SERVICE")
Rel(walletController, walletService, "calls")
Rel(transactionController, transactionService, "calls")
Rel_Back(handler, transactionController, "TransactionServiceException and framework errors")
Rel(transactionController, validators, "@Valid on the transfer body")
Rel(transactionService, validators, "search date range")
Rel(transactionService, signer, "issues the offerToken (init)")
Rel(transactionService, offerValidator, "checks the offerToken (confirm)")
Rel(offerValidator, signer, "reads the terms")
Rel(publisher, metrics, "send failures")
Rel(consumer, metrics, "DLT")
Rel(metrics, repositories, "unsent events, PENDING")
Rel(migrations, shard0, "Flyway migrations", "JDBC")
Rel(migrations, shard1, "Flyway migrations", "JDBC")
Rel(transactionService, walletService, "checks, Debit / Credit")
Rel(transactionService, mappers, "DTOs <-> entities")
Rel(walletService, mappers, "DTOs <-> entities")
Rel(transactionService, repositories, "transactions, events")
Rel(walletService, repositories, "wallets")
Rel(publisher, repositories, "reads and marks the events")
Rel(consumer, transactionService, "finalize(transactionId, userId)")
Rel(repositories, sharding, "SQL", "JPA")
Rel(sharding, shard0, "SQL", "JDBC")
Rel(sharding, shard1, "SQL", "JDBC")
Rel(publisher, kafka, "DepositRequested, WithdrawalRequested", "Avro")
Rel(kafka, consumer, "DepositCompleted / Failed, WithdrawalCompleted / Failed (with userId)", "Avro")
Rel(publisher, schemaRegistry, "registers schemas", "HTTP")
Rel(consumer, schemaRegistry, "reads schemas", "HTTP")
Rel(consumer, kafka, "a message that ran out of retries", "DLT")
Rel(transactionService, observability, "spans", "OTLP")
Rel(metrics, observability, "metrics", "/actuator/prometheus")

SHOW_LEGEND()
@enduml
