@startuml component
!include <C4/C4_Component>

title transaction-service — компонентная диаграмма (C4, уровень 3)

Container_Ext(individualsApi, "individuals-api", "Spring Boot WebFlux", "Вызывает transaction-service через transaction-service-client, user_uid из токена")
ContainerDb(shard0, "PostgreSQL shard_0", "кошельки, транзакции, transaction_events", "hash(user_uid) % 2 = 0")
ContainerDb(shard1, "PostgreSQL shard_1", "кошельки, транзакции, transaction_events", "hash(user_uid) % 2 = 1")
Container_Ext(kafka, "Kafka", "KRaft", "deposit / withdrawal события")
Container_Ext(schemaRegistry, "Schema Registry", "Confluent", "Avro-схемы событий")
Container_Ext(observability, "Prometheus / Alloy", "метрики, трассы, логи", "Стек наблюдаемости")

Container_Boundary(app, "transaction-service") {
    Component(walletController, "WalletRestControllerV1", "Spring MVC, реализует сгенерированный WalletsApi", "/api/v1/wallets: создание, кошелёк по id, кошельки пользователя")
    Component(transactionController, "TransactionRestControllerV1", "Spring MVC, реализует сгенерированный TransactionsApi", "/api/v1/transactions: init, confirm, статус, поиск")
    Component(handler, "GlobalExceptionHandler", "@RestControllerAdvice", "Отвечает на любую ошибку в формате RFC 9457")
    Component(transactionService, "TransactionService", "Spring-сервис, @Transactional", "init считает условия без записи и выдаёт requestId; confirm в одной транзакции: повторные проверки, транзакция, событие с traceparent; finalize в одной транзакции: статус только из PENDING, затем баланс")
    Component(walletService, "WalletService", "Spring-сервис", "Проверки кошелька, Debit / Credit с блокировкой FOR UPDATE")
    Component(mappers, "WalletMapper, TransactionMapper", "ручной маппинг", "Сгенерированные DTO <-> сущности")
    Component(repositories, "WalletRepository, WalletTypeRepository, TransactionRepository, TransactionEventRepository", "Spring Data JPA", "Кошельки, типы кошельков, транзакции, исходящие события")
    Component(sharding, "ShardingSphere-JDBC", "JDBC-драйвер", "Направляет SQL в шард по user_uid")
    Component(publisher, "TransactionKafkaProducer", "@Scheduled, KafkaTemplate, Avro", "Отправляет неотправленные записи transaction_events в Kafka с traceparent; помечает отправленной только после подтверждения broker, при ошибке — повтор")
    Component(consumer, "TransactionKafkaConsumer", "@KafkaListener, Avro", "Принимает *Completed / *Failed и передаёт в TransactionService; ошибка → retry → DLT")
}

Rel(individualsApi, walletController, "REST /api/v1/wallets", "HTTP, JSON")
Rel(individualsApi, transactionController, "REST /api/v1/transactions", "HTTP, JSON")
Rel(walletController, walletService, "вызывает")
Rel(transactionController, transactionService, "вызывает")
Rel_Back(handler, transactionController, "TransactionException и ошибки фреймворка")
Rel(transactionService, walletService, "проверки, Debit / Credit")
Rel(transactionService, mappers, "DTO <-> сущности")
Rel(walletService, mappers, "DTO <-> сущности")
Rel(transactionService, repositories, "транзакции, события")
Rel(walletService, repositories, "кошельки")
Rel(publisher, repositories, "читает и помечает события")
Rel(consumer, transactionService, "finalize(transactionId, userId)")
Rel(repositories, sharding, "SQL", "JPA")
Rel(sharding, shard0, "SQL", "JDBC")
Rel(sharding, shard1, "SQL", "JDBC")
Rel(publisher, kafka, "DepositRequested, WithdrawalRequested", "Avro")
Rel(kafka, consumer, "DepositCompleted / Failed, WithdrawalCompleted / Failed (с userId)", "Avro")
Rel(publisher, schemaRegistry, "регистрирует схемы", "HTTP")
Rel(consumer, schemaRegistry, "читает схемы", "HTTP")
Rel(consumer, kafka, "сообщение, для которого кончились попытки", "DLT")
Rel(transactionService, observability, "спаны и метрики операций", "OTLP, /actuator/prometheus")

SHOW_LEGEND()
@enduml
