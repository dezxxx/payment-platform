@startuml container
!include <C4/C4_Container>

title transaction-service — контейнерная диаграмма (C4, уровень 2)

Person(client, "Клиент", "Создаёт кошельки, пополняет, переводит, выводит")

Container_Ext(individualsApi, "individuals-api", "Spring Boot WebFlux", "Оркестратор: проверяет токен, берёт user_uid из него и передаёт запрос дальше")
Container_Ext(keycloak, "Keycloak", "провайдер идентификации", "Аккаунты, токены, ключи подписи (JWKS)")
Container_Ext(personService, "person-service", "Spring Boot MVC", "Хранит физлиц; transaction-service к нему не обращается")

System_Boundary(ts, "transaction-service") {
    Container(app, "transaction-service", "Spring Boot MVC, Java 25, ShardingSphere-JDBC", "Кошельки и транзакции: init считает условия, confirm создаёт транзакцию; TransactionKafkaProducer публикует события, TransactionKafkaConsumer финализирует")
    ContainerDb(shard0, "PostgreSQL shard_0", "кошельки, транзакции, transaction_events", "Пользователи с hash(user_uid) % 2 = 0")
    ContainerDb(shard1, "PostgreSQL shard_1", "кошельки, транзакции, transaction_events", "Пользователи с hash(user_uid) % 2 = 1")
}

Container_Ext(kafka, "Kafka", "Apache Kafka 4, KRaft, один broker", "Шина событий deposit / withdrawal")
Container_Ext(schemaRegistry, "Schema Registry", "Confluent", "Схемы Avro событий, проверка совместимости")
System_Ext(provider, "Fake Payment Provider", "Имитация внешнего платёжного провайдера; отвечает на *Requested событием *Completed или *Failed")

Container_Ext(nexus, "Nexus", "Maven-репозиторий", "Хранит клиент transaction-service-client")
Container_Ext(prometheus, "Prometheus", "метрики", "Собирает /actuator/prometheus")
Container_Ext(alloy, "Alloy", "агент телеметрии", "Принимает трассы, читает логи, отправляет их в Tempo и Loki")
Container_Ext(tempo, "Tempo", "хранилище трасс", "Трассы: init, confirm, отправка в Kafka, финализация")
Container_Ext(loki, "Loki", "хранилище логов", "JSON-логи с traceId, transactionId, requestId")
Container_Ext(grafana, "Grafana", "дашборды", "Метрики, трассы, логи в одном интерфейсе")

Rel(client, individualsApi, "REST /api/v1/wallets, /api/v1/transactions", "HTTP, JSON, Bearer-токен")
Rel(individualsApi, keycloak, "проверка токена", "JWKS")
Rel(individualsApi, personService, "профиль физлица", "REST")
Rel(individualsApi, app, "REST /api/v1/wallets, /api/v1/transactions, user_uid из токена", "transaction-service-client")
Rel(app, shard0, "читает и пишет", "JDBC через ShardingSphere")
Rel(app, shard1, "читает и пишет", "JDBC через ShardingSphere")
Rel(app, kafka, "DepositRequested, WithdrawalRequested (из transaction_events)", "Avro")
Rel(kafka, app, "DepositCompleted / Failed, WithdrawalCompleted / Failed (с userId)", "Avro, consumer group")
Rel(kafka, provider, "*Requested", "Avro")
Rel(provider, kafka, "*Completed / *Failed", "Avro")
Rel(app, schemaRegistry, "регистрирует и читает схемы", "HTTP")
Rel(provider, schemaRegistry, "читает схемы", "HTTP")
Rel(nexus, individualsApi, "импорт клиента", "Maven")
Rel(prometheus, app, "забирает метрики", "HTTP")
Rel(app, alloy, "трассы", "OTLP")
Rel(alloy, app, "читает JSON-логи из stdout", "Docker")
Rel(alloy, tempo, "трассы", "OTLP")
Rel(alloy, loki, "логи", "HTTP")
Rel(grafana, prometheus, "читает метрики", "PromQL")
Rel(grafana, tempo, "читает трассы", "TraceQL")
Rel(grafana, loki, "читает логи", "LogQL")

SHOW_LEGEND()
@enduml
