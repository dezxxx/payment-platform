@startuml sequence-wallet-create
title Создание кошелька (POST /wallets)

actor "Клиент" as Client
participant "individuals-api" as IA
box "transaction-service" #F5F9FF
    participant "WalletService" as WS
    database "БД (шард по user_uid)" as DB
end box

Client -> IA: POST /api/v1/wallets (name, тип кошелька)
alt токен невалиден
    IA --> Client: 401
end
IA -> IA: user_uid из токена
IA -> WS: create wallet, user_uid
alt запрос невалиден (@Valid: name пустой или длиннее 32, нет типа)
    WS --> IA: 400 ErrorResponse
    IA --> Client: 400
end
group одна транзакция БД
    WS -> DB: SELECT * FROM wallet_types WHERE uid = :walletTypeUid
    note right of DB
      wallet_types — копия на каждом шарде (broadcast),
      читается из любого
    end note
    alt тип не найден
        WS -> WS: ROLLBACK — ничего не записано
        WS --> IA: 404 ErrorResponse
        IA --> Client: 404
    else тип в архиве или не активен
        WS -> WS: ROLLBACK — ничего не записано
        WS --> IA: 400 ErrorResponse
        IA --> Client: 400
    end
    WS -> DB: INSERT INTO wallets (uid, name, wallet_type_uid, user_uid, status, balance)\nVALUES (:uid, :name, :walletTypeUid, :userUid, 'ACTIVE', 0)
    note right of DB
      ShardingSphere: hash(user_uid) % 2 —
      кошелёк ложится в шард пользователя
    end note
    alt ошибка БД
        WS -> WS: ROLLBACK — ничего не записано
        WS --> IA: 500 ErrorResponse
        IA --> Client: 500
    end
end
WS --> IA: 201 WalletResponse
IA --> Client: 201 WalletResponse
@enduml
