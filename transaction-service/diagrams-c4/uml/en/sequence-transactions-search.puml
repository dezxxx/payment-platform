@startuml sequence-transactions-search
title Search transactions (GET /transactions)

actor "Client" as Client
participant "individuals-api" as IA
box "transaction-service" #F5F9FF
    participant "TransactionService" as TS
    database "DB (shard by user_uid)" as DB
end box

Client -> IA: GET /api/v1/transactions\n?walletUid&type&status&dateFrom&dateTo&page=0&size=20
alt invalid token
    IA --> Client: 401
else valid token
    IA -> IA: user_uid from the token
    note right of IA
      A userUid filter from the client is not accepted:
      the user_uid from the token is used
    end note
    IA -> TS: search (user_uid, filters, page, size)
    alt invalid parameters
        TS --> IA: 400 ErrorResponse
        IA --> Client: 400
        note right of Client
          type not one of deposit / withdrawal / transfer;
          status not one of PENDING / COMPLETED / FAILED;
          dateFrom after dateTo;
          page < 0; size < 1 or above 100
        end note
    else valid parameters
        TS -> DB: SELECT * FROM transactions\nWHERE user_uid = :userUid\n  [AND wallet_uid = :walletUid] [AND type = :type] [AND status = :status]\n  [AND created_at >= :dateFrom] [AND created_at < :dateTo]\nORDER BY created_at DESC, uid\nLIMIT :size OFFSET :page * :size
        note right of DB
          [ ] — the condition is added only when the filter is given.
          user_uid is always in the condition → ShardingSphere goes to one shard
          and only the user's transactions are visible; another user's walletUid gives an empty list.
          Pagination: LIMIT — rows per page,
          OFFSET — rows to skip (page = 2, size = 20 → skip 40).
          ORDER BY with uid — a stable order, pages do not overlap.
          Index (user_uid, created_at).
        end note
        alt DB error
            TS --> IA: 500 ErrorResponse
            IA --> Client: 500
        else 0 rows — nothing found
            TS --> IA: 200 []
            IA --> Client: 200 []
        else 1 or more rows
            TS --> IA: 200 list of TransactionStatusResponse (at most size)
            IA --> Client: 200 list of TransactionStatusResponse
        end
    end
end
@enduml
