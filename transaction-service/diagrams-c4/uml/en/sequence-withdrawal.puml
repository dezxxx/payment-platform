@startuml sequence-withdrawal
title Withdrawal

actor "Client" as Client
participant "individuals-api" as IA
box "transaction-service" #F5F9FF
    participant "TransactionService" as TS
    participant "WalletService" as WS
    database "DB (shard by user_uid)" as DB
    participant "TransactionKafkaProducer" as Pub
    participant "TransactionKafkaConsumer" as Cons
end box
queue "Kafka" as Kafka
participant "Fake Payment Provider" as PP

== init: compute the terms, nothing is written ==
Client -> IA: POST /api/v1/transactions/withdrawal/init (walletUid, amount)
alt invalid token
    IA --> Client: 401
end
IA -> IA: user_uid from the token
IA -> TS: calc withdrawal conditions (init), userUid
alt invalid request (@Valid)
    TS --> IA: 400 ErrorResponse
    IA --> Client: 400
end
TS -> WS: check the wallet and the balance
WS -> DB: SELECT * FROM wallets\nWHERE uid = :walletUid AND user_uid = :userUid
alt 0 rows — wallet not found or not the user's
    TS --> IA: 404 ErrorResponse
    IA --> Client: 404
else status <> 'ACTIVE' or balance < amount + fee
    TS --> IA: 400 ErrorResponse
    IA --> Client: 400
end
WS --> TS: OK
TS -> TS: fee, total, new requestId (UUID)
TS --> IA: terms + requestId
IA --> Client: withdrawal terms + requestId

== confirm: debit and create the transaction ==
Client -> IA: POST /api/v1/transactions/withdrawal/confirm (requestId, walletUid, amount)
IA -> TS: confirm withdrawal, userUid
group one DB transaction
    TS -> DB: SELECT uid, status FROM transactions\nWHERE user_uid = :userUid AND request_id = :requestId
    alt 1 row — repeated confirm
        TS --> IA: 200, its transactionId and current status
        IA --> Client: 200, the same transactionId — no second debit
    end
    TS -> TS: recompute the fee (the init terms are not trusted)
    TS -> WS: debit amount + fee (reserve)
    WS -> DB: SELECT * FROM wallets\nWHERE uid = :walletUid AND user_uid = :userUid\nFOR UPDATE
    alt 0 rows — wallet not found or not the user's
        TS -> TS: ROLLBACK — nothing written
        TS --> IA: 404 ErrorResponse
        IA --> Client: 404
    else status <> 'ACTIVE' or balance < amount + fee
        TS -> TS: ROLLBACK — nothing written
        TS --> IA: 400 ErrorResponse
        IA --> Client: 400
    end
    WS -> DB: UPDATE wallets SET balance = balance - (:amount + :fee), modified_at = now()\nWHERE uid = :walletUid AND user_uid = :userUid
    TS -> DB: INSERT INTO transactions\n(uid, user_uid, wallet_uid, amount, fee, type, status, request_id)\nVALUES (:transactionId, :userUid, :walletUid, :amount, :fee, 'WITHDRAWAL', 'PENDING', :requestId)
    TS -> DB: INSERT INTO transaction_events\n(uid, transaction_uid, user_uid, event_type, payload, traceparent, sent_at)\nVALUES (:eventId, :transactionId, :userUid, 'WithdrawalRequested', :payload, :traceparent, NULL)
    alt DB error (incl. a UNIQUE (user_uid, request_id) violation)
        TS -> TS: ROLLBACK — no debit, nothing written
        TS --> IA: 500 ErrorResponse
        IA --> Client: 500
    end
end
TS --> IA: status=PENDING, transactionId
IA --> Client: status=PENDING, transactionId
note right of IA
  init and confirm are separate HTTP requests and separate traces.
  requestId links them: it is in the span attributes and logs of both.
end note

== async: the event goes to Fake Payment Provider ==
loop on a schedule (@Scheduled)
    Pub -> DB: SELECT * FROM transaction_events\nWHERE sent_at IS NULL\nORDER BY created_at LIMIT :batchSize
    note right of DB
      no user_uid — ShardingSphere
      reads both shards, as intended
    end note
    Pub -> Kafka: WithdrawalRequested (Avro, key = transactionId, userId)\ntraceparent header from the row
    alt the broker acknowledged
        Kafka --> Pub: ack
        Pub -> DB: UPDATE transaction_events SET sent_at = now()\nWHERE uid = :eventId AND user_uid = :userUid
    else Kafka unavailable or no acknowledgement
        Kafka --> Pub: error / timeout
        Pub -> Pub: log ERROR; sent_at stays NULL — retried on the next run;\nthe funds are reserved, the transaction is PENDING
    end
end
Kafka -> PP: WithdrawalRequested
PP -> Kafka: WithdrawalCompleted or WithdrawalFailed\n(transactionId, userId, traceparent — the same trace continues)
note over PP
  No answer — the transaction stays PENDING, the funds stay reserved.
  Visible on the "PENDING age" metric, which has an alert.
end note

== async: finalization ==
Kafka -> Cons: WithdrawalCompleted / WithdrawalFailed
Cons -> TS: finalize (transactionId, userId)
note right of Cons
  userId from the event → ShardingSphere goes
  to one shard, not to all
end note
group one DB transaction (TransactionService)
    alt WithdrawalCompleted
        TS -> DB: UPDATE transactions SET status = 'COMPLETED', modified_at = now()\nWHERE uid = :transactionId AND user_uid = :userId AND status = 'PENDING'
        alt 1 row changed
            TS -> TS: done: the funds were debited at confirm
        else 0 rows changed
            TS -> DB: SELECT status FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            alt 1 row, status already final — repeated message
                TS -> TS: log INFO, nothing changes
            else 0 rows — transaction not found
                TS -> TS: exception → ROLLBACK
            end
        end
    else WithdrawalFailed
        TS -> DB: UPDATE transactions SET status = 'FAILED', failure_reason = :failureReason,\nmodified_at = now()\nWHERE uid = :transactionId AND user_uid = :userId AND status = 'PENDING'
        alt 1 row changed — first processing
            TS -> DB: SELECT wallet_uid, amount, fee FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            TS -> WS: return amount + fee (walletUid)
            WS -> DB: UPDATE wallets SET balance = balance + (:amount + :fee), modified_at = now()\nWHERE uid = :walletUid AND user_uid = :userId
        else 0 rows changed
            TS -> DB: SELECT status FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            alt 1 row, status already final — repeated message
                TS -> TS: log INFO, the funds are not returned twice
            else 0 rows — transaction not found
                TS -> TS: exception → ROLLBACK
            end
        end
    end
end
alt processing finished without an exception
    Cons -> Kafka: commit offset
else exception (DB unavailable, transaction not found)
    Cons -> Cons: ROLLBACK; retry with a pause (DefaultErrorHandler)
    Cons -> Kafka: retries exhausted → message to the DLT, log ERROR
end
@enduml
