@startuml sequence-withdrawal
title Withdrawal

actor "Client" as Client
participant "individuals-api" as IA
box "transaction-service" #F5F9FF
    participant "TransactionService" as TS
    participant "WalletService" as WS
    database "DB (shard by user_uid)" as DB
    participant "TransactionKafkaProducer" as Pub
    participant "TransactionKafkaConsumer" as Cons
end box
queue "Kafka" as Kafka
participant "Fake Payment Provider" as PP

== init: compute the terms, nothing is written ==
Client -> IA: POST /api/v1/transactions/withdrawal/init (walletUid, amount)
alt invalid token
    IA --> Client: 401
else valid token
    IA -> IA: user_uid from the token
    IA -> TS: calc withdrawal conditions (init), userUid
    alt invalid body (@Valid in the controller): missing field, not a UUID,\namount <= 0, more than 2 decimal places
        TS --> IA: 400 ErrorResponse
        IA --> Client: 400
    else valid body
        TS -> WS: read the wallet
        WS -> DB: SELECT w.uid, w.status, w.balance, t.currency_code FROM wallets w\nJOIN wallet_types t ON t.uid = w.wallet_type_uid\nWHERE w.uid = :walletUid AND w.user_uid = :userUid AND w.archived_at IS NULL
        alt DB error
            TS --> IA: 500 ErrorResponse
            IA --> Client: 500
        else 0 rows — wallet not found, not the user's or archived
            TS --> IA: 404 ErrorResponse
            IA --> Client: 404
        else status <> 'ACTIVE'
            TS --> IA: 400 ErrorResponse
            IA --> Client: 400
        else the wallet is fine
            TS -> TS: compute the fee
            alt balance < amount + fee
                TS --> IA: 400 ErrorResponse — not enough including the fee
                IA --> Client: 400
            else enough funds
                TS -> TS: new requestId (UUID), not stored in the DB
                TS --> IA: amount, fee, total, requestId
                IA --> Client: 200, withdrawal terms + requestId
            end
        end
    end
end

== confirm: debit (reserve) and create the transaction, one DB transaction ==
Client -> IA: POST /api/v1/transactions/withdrawal/confirm (requestId, walletUid, amount)
alt invalid token
    IA --> Client: 401
else valid token
    IA -> IA: user_uid from the token
    IA -> TS: confirm withdrawal, userUid
    alt invalid body (@Valid in the controller): missing field, not a UUID,\namount <= 0, more than 2 decimal places
        TS --> IA: 400 ErrorResponse — no DB transaction was started
        IA --> Client: 400
    else valid body
        group one DB transaction
            TS -> DB: INSERT INTO transactions\n(uid, user_uid, wallet_uid, amount, type, status, request_id)\nVALUES (:transactionId, :userUid, :walletUid, :amount, 'WITHDRAWAL', 'PENDING', :requestId)\nON CONFLICT (user_uid, request_id) DO NOTHING\nRETURNING uid
            note right of DB
              The requestId is claimed first, in one statement.
              If another request with this requestId has not finished
              its transaction yet, this INSERT waits for it.
              The PENDING row is not visible outside until COMMIT.
            end note
            alt 0 rows — requestId already taken (a repeat, incl. a concurrent one)
                TS -> DB: SELECT uid, status, type, wallet_uid, amount FROM transactions\nWHERE user_uid = :userUid AND request_id = :requestId
                alt type, wallet or amount differ from the request
                    TS --> IA: 409 ErrorResponse — requestId already used for another operation
                    IA --> Client: 409
                else same parameters
                    TS --> IA: 200, its transactionId and current status
                    IA --> Client: 200, the same transactionId — no second debit
                end
            else 1 row — requestId claimed by this request
                TS -> WS: debit amount + fee (reserve)
                WS -> DB: SELECT w.uid, w.status, w.balance, t.currency_code FROM wallets w\nJOIN wallet_types t ON t.uid = w.wallet_type_uid\nWHERE w.uid = :walletUid AND w.user_uid = :userUid AND w.archived_at IS NULL\nFOR UPDATE OF w
                note right of DB
                  FOR UPDATE — another operation on this wallet
                  waits until this transaction ends: the balance
                  checked below cannot change before the debit
                end note
                alt 0 rows — wallet not found, not the user's or archived
                    TS -> DB: ROLLBACK — no transaction row, the requestId is free again
                    TS --> IA: 404 ErrorResponse
                    IA --> Client: 404
                else status <> 'ACTIVE'
                    TS -> DB: ROLLBACK — nothing written
                    TS --> IA: 400 ErrorResponse
                    IA --> Client: 400
                else the wallet is fine
                    TS -> TS: compute the fee (the init terms are not trusted)
                    alt balance < amount + fee
                        TS -> DB: ROLLBACK — nothing written
                        TS --> IA: 400 ErrorResponse — not enough including the fee
                        IA --> Client: 400
                    else enough funds
                        WS -> DB: UPDATE wallets SET balance = balance - (:amount + :fee), modified_at = now()\nWHERE uid = :walletUid AND user_uid = :userUid
                        TS -> DB: UPDATE transactions SET fee = :fee\nWHERE uid = :transactionId AND user_uid = :userUid
                        TS -> DB: INSERT INTO transaction_events\n(uid, transaction_uid, user_uid, event_type, payload, traceparent, sent_at)\nVALUES (:eventId, :transactionId, :userUid, 'WithdrawalRequested', :payload, :traceparent, NULL)
                        alt DB error
                            TS -> DB: ROLLBACK — no debit, no transaction, no event
                            TS --> IA: 500 ErrorResponse
                            IA --> Client: 500
                        else writes succeeded
                            TS -> DB: COMMIT — debit, PENDING transaction and event saved together
                            TS --> IA: 200, status=PENDING, transactionId
                            IA --> Client: 200, status=PENDING, transactionId
                        end
                    end
                end
            end
        end
        note right of DB
          A DB error at any step of the group (incl. a lock
          timeout) → ROLLBACK, 500, nothing written.
          Response lost after COMMIT → the client repeats
          confirm with the same requestId → "0 rows" branch → 200.
        end note
    end
end
note right of IA
  init and confirm are separate HTTP requests and separate traces.
  requestId links them: it is in the span attributes and logs of both.
  confirm without init is allowed: confirm checks everything itself.
end note

== async: the event goes to Fake Payment Provider ==
loop on a schedule (@Scheduled)
    Pub -> DB: SELECT * FROM transaction_events\nWHERE sent_at IS NULL\nORDER BY created_at LIMIT :batchSize
    note right of DB
      no user_uid — ShardingSphere
      reads both shards, as intended
    end note
    Pub -> Kafka: WithdrawalRequested (Avro, key = transactionId, userId)\ntraceparent header from the row
    alt the broker acknowledged (ack)
        Kafka --> Pub: ack
        Pub -> DB: UPDATE transaction_events SET sent_at = now()\nWHERE uid = :eventId AND user_uid = :userUid
    else Kafka unavailable or no acknowledgement
        Kafka --> Pub: error / timeout
        Pub -> Pub: log ERROR; sent_at stays NULL — retried on the next run;\nthe funds are reserved, the transaction is PENDING
    end
end
Kafka -> PP: WithdrawalRequested
alt the money was sent to the card
    PP -> Kafka: WithdrawalCompleted (transactionId, userId, traceparent)
else declined: the bank refused
    PP -> Kafka: WithdrawalFailed (transactionId, userId, failureReason, traceparent)
end
note over PP
  No answer — the transaction stays PENDING, the funds stay reserved.
  Visible on the "PENDING age" metric, which has an alert.
end note

== async: finalization ==
Kafka -> Cons: WithdrawalCompleted / WithdrawalFailed
Cons -> TS: finalize (transactionId, userId)
note right of Cons
  userId from the event → ShardingSphere goes
  to one shard, not to all
end note
group one DB transaction (TransactionService)
    alt WithdrawalCompleted
        TS -> DB: UPDATE transactions SET status = 'COMPLETED', modified_at = now()\nWHERE uid = :transactionId AND user_uid = :userId AND status = 'PENDING'
        alt 1 row changed — first processing
            TS -> TS: done: the funds were debited at confirm
        else 0 rows changed
            TS -> DB: SELECT status FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            alt 1 row, status already final — repeated message
                TS -> TS: log INFO, nothing changes
            else 0 rows — transaction not found
                TS -> TS: exception
            end
        end
    else WithdrawalFailed
        TS -> DB: UPDATE transactions SET status = 'FAILED', failure_reason = :failureReason,\nmodified_at = now()\nWHERE uid = :transactionId AND user_uid = :userId AND status = 'PENDING'
        alt 1 row changed — first processing
            TS -> DB: SELECT wallet_uid, amount, fee FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            TS -> WS: return amount + fee (walletUid)
            WS -> DB: UPDATE wallets SET balance = balance + (:amount + :fee), modified_at = now()\nWHERE uid = :walletUid AND user_uid = :userId
        else 0 rows changed
            TS -> DB: SELECT status FROM transactions\nWHERE uid = :transactionId AND user_uid = :userId
            alt 1 row, status already final — repeated message
                TS -> TS: log INFO, the funds are not returned twice
            else 0 rows — transaction not found
                TS -> TS: exception
            end
        end
    end
end
alt no exception
    TS -> DB: COMMIT
    Cons -> Kafka: commit offset
else exception (DB unavailable, transaction not found)
    TS -> DB: ROLLBACK — nothing written
    Cons -> Cons: retry with a pause (DefaultErrorHandler)
    Cons -> Kafka: retries exhausted → message to the DLT, log ERROR
end
@enduml
