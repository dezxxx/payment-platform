@startuml sequence-deposit
title Deposit

actor "Client" as Client
participant "individuals-api" as IA
box "transaction-service" #F5F9FF
    participant "TransactionService" as TS
    participant "WalletService" as WS
    database "DB (the user's shard)" as DB
    participant "TransactionKafkaProducer" as Pub
    participant "TransactionKafkaConsumer" as Cons
end box
queue "Kafka" as Kafka
participant "Fake Payment Provider" as PP

== init: compute the terms, nothing is written ==
Client -> IA: POST /api/v1/transactions/deposit/init
IA -> IA: user_uid from the token
IA -> TS: calc deposit conditions (init)
TS -> WS: check the wallet (belongs to user_uid, active)
WS --> TS: OK
TS --> IA: terms (fee, total)
IA --> Client: deposit terms

== confirm: create the transaction ==
Client -> IA: POST /api/v1/transactions/deposit/confirm
IA -> TS: confirm deposit
TS -> WS: check the wallet
WS --> TS: OK
group one DB transaction
    TS -> DB: transaction PENDING
    TS -> DB: transaction_events: DepositRequested
end
TS --> IA: status=PENDING, transactionId
IA --> Client: status=PENDING, transactionId

== async: the event goes to Fake Payment Provider ==
Pub -> DB: unsent rows of transaction_events
Pub -> Kafka: DepositRequested (Avro, key = transactionId)
Pub -> DB: transaction_events row sent
Kafka -> PP: DepositRequested
PP -> Kafka: DepositCompleted or DepositFailed

== async: finalization ==
Kafka -> Cons: DepositCompleted / DepositFailed
alt DepositCompleted
    group one DB transaction
        Cons -> DB: status PENDING → COMPLETED
        Cons -> WS: credit the funds
        WS -> DB: balance += amount
    end
else DepositFailed
    group one DB transaction
        Cons -> DB: status PENDING → FAILED, failure_reason
    end
end
note right of Cons
  The status changes only from PENDING:
  a repeated message changes nothing
end note
@enduml
