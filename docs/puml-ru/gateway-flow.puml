@startuml user-journey
title Вся история - один человек, от первого запроса до /me

skinparam shadowing false
autonumber

actor "Пользователь" as U
participant "AuthController" as Ctl
participant "AuthenticationService" as Auth
participant "RegistrationService" as Reg
box "gateway" #F7F7F7
  participant "PersonServiceGateway" as PG
  participant "KeycloakOidcGateway" as OG
  participant "KeycloakAdminGateway" as AG
end box
participant "person-service" as PS
participant "Keycloak" as KC

== Пробует войти, но учётки у него ещё нет ==

U -> Ctl : POST /api/v1/auth/login\n{ "email": "ivan@dezxxx.com",\n  "password": "Str0ngP@ssw0rd" }
Ctl -> Auth : login(request)
Auth -> OG : login(email, password)
OG -> KC : POST /realms/{realm}/protocol/openid-connect/token\nформа: grant_type=password
KC --> OG : 400 { "error": "invalid_grant",\n       "error_description": "Invalid user credentials" }

note right of OG
  Keycloak отвечает 400. Наш контракт говорит 401.
  KeycloakErrorTranslator перечитывает:
  invalid_grant -> INVALID_CREDENTIALS.
end note

OG --> Auth : ApiException(INVALID_CREDENTIALS)
Auth --> Ctl : (ошибка поднимается по цепочке)
Ctl --> U : 401 Unauthorized\n{ "error": "INVALID_CREDENTIALS",\n  "message": "Email or password is incorrect" }

note over U
  Намеренно расплывчато. "Такой почты нет" и
  "неверный пароль" отвечают одинаково, чтобы
  никто не мог узнать, какие адреса существуют.
end note

== Тогда он регистрируется. Вот нужные поля ==

U -> Ctl : POST /api/v1/auth/registration\n{ "email", "password", "confirmPassword",\n  "firstName", "lastName" }

note right of Ctl
  @Valid отрабатывает до всего остального:
  формат почты, пароль 8..72,
  firstName/lastName не пустые,
  confirmPassword равен password.
  Сбой здесь до сервиса не доходит -
  400 VALIDATION_ERROR со строкой в details[]
  на каждое неверное поле.
end note

Ctl -> Reg : register(request)
activate Reg

Reg -> PG : createPerson(email, firstName, lastName)
PG -> PS : POST /api/v1/persons/registration
PS --> PG : 201 { "userUid": "6f1d2a4e-..." }
PG --> Reg : UUID
note right of PG
  Пароль сюда не отправляется.
  Профиль принадлежит person-service,
  учётные данные - Keycloak.
end note

Reg -> AG : createUser(email, firstName, lastName, userUid)
AG -> OG : serviceAccountToken()
OG -> KC : POST /token  grant_type=client_credentials
KC --> OG : 200 { access_token }
OG --> AG : служебный токен
AG -> KC : POST /admin/realms/{realm}/users\nBearer <служебный токен>
KC --> AG : 201 Created\nLocation: .../users/0b7a5f2c-...
AG --> Reg : keycloakUserId

Reg -> AG : setPassword(keycloakUserId, password)
AG -> KC : PUT /admin/realms/{realm}/users/{id}/reset-password\n{ "type":"password", "value":"...", "temporary": false }
KC --> AG : 204 No Content
AG --> Reg : готово

Reg -> AG : assignPlatformRole(keycloakUserId)
AG -> KC : GET /admin/realms/{realm}/roles/USER
KC --> AG : 200 { id, name }
AG -> KC : POST /admin/realms/{realm}/users/{id}/role-mappings/realm\n[ { id, name } ]
KC --> AG : 204 No Content
AG --> Reg : готово
note right of AG
  Роль выдаётся здесь, а не импортом realm:
  Keycloak принимает realmRoles в теле
  создания и молча их игнорирует.
  Два вызова, потому что привязка идёт по id,
  а id известен только после чтения роли.
end note

Reg -> OG : login(email, password)
OG -> KC : POST /token  grant_type=password
KC --> OG : 200 { access_token, refresh_token,\n       expires_in, token_type }
OG --> Reg : TokenResponse
Reg -> Reg : tokens.userUid(userUid)
Reg --> Ctl : TokenResponse
deactivate Reg

Ctl --> U : 201 Created\n{ accessToken, refreshToken,\n  expiresIn, tokenType, userUid }

== Теперь спрашивает, кто он ==

U -> Ctl : GET /api/v1/auth/me\nAuthorization: Bearer <accessToken>

note right of Ctl
  Цепочка фильтров безопасности проверила
  подпись до того, как дело дошло до контроллера.
  Семь полей из восьми уже лежат в токене -
  обращений по сети за ними не нужно.
end note

Ctl -> Auth : currentUser(jwt)
Auth -> AG : findRegisteredAt(sub)
AG -> KC : GET /admin/realms/{realm}/users/{sub}
KC --> AG : 200 { ..., "createdTimestamp": 1755600000000 }
AG --> Auth : OffsetDateTime (UTC)
Auth --> Ctl : CurrentUserResponse
Ctl --> U : 200 { userUid, keycloakUserId, email,\n     firstName, lastName, emailVerified,\n     roles, registeredAt }

@enduml


@startuml gateway-structure
title Слой шлюзов - кто что знает

skinparam shadowing false
skinparam classAttributeIconSize 0

package "service (только оркестрация)" #FDFDF0 {
  class RegistrationService
  class AuthenticationService
}

package gateway {

  class GatewayErrors <<утиль>> {
    + transportFailures(dependency, baseUrl)
  }
  note right of GatewayErrors
    Общий для КАЖДОГО шлюза.
    "Никто вообще не ответил" ->
    503 DEPENDENCY_UNAVAILABLE.
  end note

  package "gateway.person" {
    class PersonServiceGateway <<@Component>> {
      + Mono<UUID> createPerson(email, firstName, lastName)
    }
    class PersonErrorTranslator <<утиль>>
  }

  package "gateway.keycloak" {

    class KeycloakErrorTranslator <<утиль>> {
      + Mono<Throwable> translate(response)
    }
    class KeycloakErrorResponse <<record>>
    note bottom of KeycloakErrorResponse
      Две формы в одной записи:
      { error, error_description }  (OIDC)
      { errorMessage }              (Admin)
    end note

    package "gateway.keycloak.oidc" {
      class KeycloakOidcGateway <<@Component>> {
        + Mono<TokenResponse> login(email, password)
        + Mono<TokenResponse> refresh(token)
        + Mono<String> serviceAccountToken()
      }
      class KeycloakTokenResponse <<record>>
    }

    package "gateway.keycloak.admin" {
      class KeycloakAdminGateway <<@Component>> {
        + Mono<String> createUser(email, firstName,\n                         lastName, userUid)
        + Mono<Void> setPassword(id, password)
        + Mono<Void> assignPlatformRole(id)
        + Mono<Void> deleteUser(id)
        + Mono<OffsetDateTime> findRegisteredAt(id)
      }
      class KeycloakUserRequest <<record>>
      class KeycloakUserRepresentation <<record>>
      class KeycloakCredential <<record>>
      class KeycloakRealmRole <<record>>
    }
  }
}

RegistrationService --> PersonServiceGateway
RegistrationService --> KeycloakAdminGateway
RegistrationService --> KeycloakOidcGateway
AuthenticationService --> KeycloakOidcGateway
AuthenticationService --> KeycloakAdminGateway

KeycloakAdminGateway --> KeycloakOidcGateway : нужен служебный токен

PersonServiceGateway ..> PersonErrorTranslator
PersonServiceGateway ..> GatewayErrors
KeycloakOidcGateway ..> KeycloakErrorTranslator
KeycloakOidcGateway ..> GatewayErrors
KeycloakAdminGateway ..> KeycloakErrorTranslator
KeycloakAdminGateway ..> GatewayErrors
KeycloakErrorTranslator ..> KeycloakErrorResponse

legend bottom
  Правило слоёв, одной строкой:
  **общий код живёт на том уровне, который накрывает всех, кто им пользуется.**
  GatewayErrors            -> все шлюзы
  KeycloakErrorTranslator  -> admin + oidc
  записи (record)          -> по одной на операцию
endlegend

@enduml


@startuml gateway-translation
title Зачем нужен шлюз - один и тот же сбой, рассказанный дважды

skinparam shadowing false

rectangle "Что сказала зависимость" #FFF0F0 {
  card "Keycloak: 400\ninvalid_grant\n\"Invalid user credentials\"" as k1
  card "Keycloak: 401\ninvalid_client" as k2
  card "Keycloak: 409\n\"User exists with same email\"" as k3
  card "Keycloak: 400\n(что-то непредвиденное)" as k4
  card "Keycloak / person-service: 5xx" as k5
  card "вообще ничего\n(отказ, DNS, таймаут)" as k6
  card "person-service: 400" as p1
}

rectangle "Что сказали клиенту" #F0FFF0 {
  card "**401** INVALID_CREDENTIALS\n\"Email or password is incorrect\"" as o1
  card "**500** INTERNAL_ERROR\n\"Unexpected error\"" as o2
  card "**409** USER_ALREADY_EXISTS\n\"Email is already registered\"" as o3
  card "**503** DEPENDENCY_UNAVAILABLE\n\"Dependency is not reachable\"" as o4
}

k1 --> o1
k2 --> o2 : наш собственный client_secret неверен -\nвызывающий ни при чём
k3 --> o3
k4 --> o2 : этот запрос собрали МЫ,\nзначит 4xx - НАША ошибка
p1 --> o2 : их проверка и наша разошлись -\nснова наша ошибка
k5 --> o4
k6 --> o4

note bottom
  Два правила, которые стоит запомнить:

  1. 4xx от зависимости обычно **не** вина вызывающего.
     Этот запрос он не отправлял - отправили мы.

  2. Формулировка зависимости до клиента не доходит.
     Она уходит в лог. "Account is not fully set up"
     описывает наши внутренности, а "User exists with
     same email" позволяет перебрать зарегистрированные
     адреса.
end note

@enduml


@startuml gateway-failures
title Регистрация - где может сломаться и что получит клиент

skinparam shadowing false

start

:POST /api/v1/auth/registration;

if (@Valid прошёл?) then (нет)
  #FFE0E0:**400** VALIDATION_ERROR
  details[] называет каждое плохое поле;
  note right: Нигде ничего не создано.
  stop
else (да)
endif

:person-service\nPOST /persons/registration;

if (создан?) then (нет)
  #FFE0E0:409 -> **409** USER_ALREADY_EXISTS
  5xx -> **503** DEPENDENCY_UNAVAILABLE
  400 -> **500** INTERNAL_ERROR;
  note right
    По-прежнему ничего не создано.
    Вызывающий может просто повторить.
  end note
  stop
else (да)
endif

:user_uid выдан;
note right #FFFFCC
  С этого места ЛЮБОЙ сбой оставляет
  person-service и Keycloak
  несогласованными по этому человеку.
end note

:Keycloak\nPOST /admin/.../users;

if (создан?) then (нет)
  #FFCCCC:**503** REGISTRATION_INCONSISTENT;
  note right
    Доменный пользователь есть, учётки нет.
    В Keycloak откатывать нечего.
    У person-service нет удаления - расхождение
    пишется в лог с user_uid и оставляется
    человеку. Принятое ограничение модуля 1.
  end note
  stop
else (да)
endif

:Keycloak\nPUT /reset-password;

if (пароль установлен?) then (нет)
  #FFCCCC:DELETE /admin/.../users/{id};
  note right
    Компенсирующее действие. Без него в учётку
    нельзя войти никогда
    (400 "Account is not fully set up"),
    а адрес остаётся занятым, поэтому повторная
    регистрация будет отвечать 409 вечно.
  end note
  #FFCCCC:**503** REGISTRATION_INCONSISTENT;
  stop
else (да)
endif

:Keycloak\nвыдать роль USER;

if (роль выдана?) then (нет)
  #FFCCCC:DELETE /admin/.../users/{id};
  note right
    Та же компенсация: учётка без роли
    бесполезна, а адрес занят.
  end note
  #FFCCCC:**503** REGISTRATION_INCONSISTENT;
  stop
else (да)
endif

:Keycloak\nPOST /token grant_type=password;

if (вход выполнен?) then (нет)
  #FFE0E0:**503** DEPENDENCY_UNAVAILABLE;
  note right
    НЕ рассогласование. Обе системы
    знают одного и того же человека;
    мы просто не смогли отдать токены.
    Вызывающий может войти обычным путём.
  end note
  stop
else (да)
endif

#CCFFCC:**201** accessToken, refreshToken,
expiresIn, tokenType, user_uid;
stop

@enduml
