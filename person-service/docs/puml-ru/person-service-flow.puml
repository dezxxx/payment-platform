@startuml person-service-flow
title person-service - создание пользователя и компенсация

skinparam shadowing false
skinparam sequenceMessageAlign left

actor "Клиент" as CL
participant "individuals-api\n(оркестратор)" as IA
participant "UsersApi /\nUserController" as C
participant "UserService\n@Transactional" as S
participant "UserMapper" as M
participant "CountryRepository" as CR
participant "UserRepository" as UR
database "PostgreSQL\nсхема person" as DB
participant "Keycloak" as KC

CL -> IA : POST /api/v1/auth/registration

== Создание ==

IA -> C : POST /api/v1/users\nCreateUserRequest
C -> S : create(request)
note right of C : DTO на входе, DTO на выходе - без логики

S -> UR : email занят? (lower(email))
UR -> DB : SELECT
alt email уже есть
  S --> C : конфликт
  C --> IA : 409 ProblemResponse
  IA --> CL : 409 - email уже зарегистрирован
end

S -> M : CreateUserRequest -> UserEntity\n+ AddressEntity + IndividualEntity
S -> CR : страна по alpha3 / alpha2
CR -> DB : SELECT
S -> UR : save(user)
UR -> DB : INSERT addresses, users, individuals\n(каскад, одна транзакция)
S -> M : UserEntity -> UserResponse
S --> C : UserResponse
C --> IA : 201 UserResponse\n(id = будущий user_uid)

== Оркестратор продолжает ==

IA -> KC : создать аккаунт с user_uid = id
alt Keycloak отработал
  IA -> KC : вход
  KC --> IA : access_token, refresh_token
  IA --> CL : 201 токены + user_uid
else Keycloak упал
  == Компенсация ==
  IA -> C : DELETE /api/v1/users/{id}
  C -> S : delete(id)
  S -> UR : delete(user)
  UR -> DB : DELETE individuals, users, addresses\n(каскад, одна транзакция)
  C --> IA : 204
  IA --> CL : ответ с ошибкой\n(существующий обработчик ошибок individuals-api)
  note over IA : не остаётся ни персоны, ни аккаунта
end

@enduml
