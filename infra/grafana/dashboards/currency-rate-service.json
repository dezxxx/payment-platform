{
  "uid": "currency-rate-service",
  "title": "currency-rate-service",
  "description": "Exchange rates: freshness of the rates, the hourly update, HTTP traffic, the database pool and the logs of currency-rate-service.",
  "tags": [
    "payment-platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Age of the newest rate",
      "description": "A new rate every hour; above 2 hours the alert CurrencyRatesTooOld fires, at 3 hours every rate has expired.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3900
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(rate_newest_age_seconds{job=\"currency-rate-service\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pairs with a valid rate",
      "description": "Every ordered pair of active currencies: 4 currencies give 12. Zero means every GET /rates answers 404.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate_valid_pairs{job=\"currency-rate-service\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Updates succeeded",
      "description": "Since the application started; only the instance that won the ShedLock lock counts an update.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate_updates_total{job=\"currency-rate-service\", result=\"success\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Updates failed",
      "description": "Since the application started: no provider gave valid rates, or the write failed. The previous rates stay valid until their rate_end_time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate_updates_total{job=\"currency-rate-service\", result=\"failure\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rate update time",
      "description": "Provider calls with retries plus the write. Must stay far below lockAtMostFor (59 min): about 46 s per provider plus 30 s for the write at worst.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate_update_duration_seconds_max{job=\"currency-rate-service\"})",
          "legendFormat": "longest update"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rate lookups per second",
      "description": "ExchangeRateService.getRate called by individuals-api: error=\"none\" found a rate, anything else names the exception (RATE_NOT_FOUND is the service exception).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error) (rate(rate_operations_seconds_count{job=\"currency-rate-service\", operation=\"getRate\"}[1m]))",
          "legendFormat": "{{error}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second, by status",
      "description": "404 climbing on /api/v1/rates means rates are missing; 401 and 403 mean a caller without the service token.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"currency-rate-service\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency, 95th percentile by endpoint",
      "description": "95 requests out of 100 answer faster than this.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"currency-rate-service\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database connection pool",
      "description": "pending above zero means requests wait for a connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{job=\"currency-rate-service\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{job=\"currency-rate-service\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{job=\"currency-rate-service\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Errors and warnings",
      "description": "A failed update is an ERROR; a provider that failed or gave incomplete rates is a WARN.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"currency-rate-service\", level=~\"ERROR|WARN\"}"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "All logs of the service",
      "description": "Expand a line: trace_id opens its trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"currency-rate-service\"}"
        }
      ]
    }
  ]
}
