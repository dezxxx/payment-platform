// Grafana Alloy: reads the stdout of every container and ships it to Loki.
// Not the Loki docker driver - that is a host plugin, and "docker compose up
// brings everything up" is an acceptance criterion. Promtail is end of life.

// 1. find the containers (Docker socket, mounted read-only)
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// 2. Docker metadata -> Loki labels. Only few-valued fields become labels:
//    each label combination is a separate stream. Never a trace id or user id
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    // Docker names start with a slash: /payment-platform-keycloak-1
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "env"
    replacement  = "docker-compose"
  }
}

// 3. read the log streams
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.structured.receiver]
}

// 4. parse individuals-api's JSON lines; plain-text lines pass through as is
loki.process "structured" {
  stage.json {
    expressions = {
      level    = "log.level",
      logger   = "log.logger",
      trace_id = "traceId",
      span_id  = "spanId",
    }
  }

  // level has few values - safe as a label
  stage.labels {
    values = {
      level = "",
    }
  }

  // trace id is one per request: metadata, not a label, or Loki drowns in streams
  stage.structured_metadata {
    values = {
      trace_id = "",
      span_id  = "",
      logger   = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// 5. push to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
