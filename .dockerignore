# Keeps the build context small and the image reproducible: everything here is
# either regenerated by the build or irrelevant to it.

.git
.gitignore
.idea
*.iml

# Build output of every module - rebuilt inside the image.
build/
*/build/
.gradle/
*/.gradle/

# Local secrets. The container gets its configuration from compose.
.env

# Documentation and scratch material.
screenShoots/
docs/
postman/
*.md
