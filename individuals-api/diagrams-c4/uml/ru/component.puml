@startuml component
!include <C4/C4_Component>

title individuals-api — компонентная диаграмма (C4, уровень 3)

Person(client, "Клиент", "Регистрируется, входит, узнаёт, кто он; открывает кошельки, переводит деньги")
Container_Ext(keycloak, "Keycloak", "провайдер идентификации", "Аккаунты, роли, токены, JWKS")
Container_Ext(personService, "person-service", "Spring Boot MVC", "Агрегат физлица")
Container_Ext(transactionService, "transaction-service", "Spring Boot MVC", "Кошельки и транзакции; верит X-User-Uid")
Container_Ext(observability, "Prometheus / Alloy", "метрики, трассы, логи", "Стек наблюдаемости")

Container_Boundary(app, "individuals-api") {
    Component(filter, "RequestLogFilter", "WebFilter", "Строка лога запроса и user_uid в контексте логов")
    Component(security, "SecurityConfig", "Spring Security, resource server", "Проверяет Bearer-токен по JWKS Keycloak; регистрация, вход и refresh открыты")
    Component(controller, "AuthController", "WebFlux, реализует сгенерированный AuthApi", "/api/v1/auth: registration, login, refresh-token, me")
    Component(walletController, "WalletController", "WebFlux, реализует сгенерированный WalletsApi", "/api/v1/wallets: создание, по uid, свои кошельки")
    Component(transactionController, "TransactionController", "WebFlux, реализует сгенерированный TransactionsApi", "/api/v1/transactions: init и confirm пополнения, вывода, перевода; статус; поиск")
    Component(validation, "PasswordsMatchValidator", "Bean Validation", "password и confirmPassword должны совпадать")
    Component(userService, "UserService", "Spring-сервис, Reactor", "Регистрация как сага: person-service, затем Keycloak, при сбое компенсация; текущий пользователь")
    Component(tokenService, "TokenService", "Spring-сервис", "Вход, refresh, user_uid из токена")
    Component(walletService, "WalletService", "Spring-сервис, Reactor", "user_uid из токена (KeycloakClaims), затем вызов кошельков")
    Component(transactionService2, "TransactionService", "Spring-сервис, Reactor", "user_uid из токена (KeycloakClaims), затем вызов транзакций")
    Component(personClient, "PersonClient", "адаптер над person-service-client", "Создание физлица, компенсация регистрации")
    Component(transactionClient, "TransactionClient", "адаптер над transaction-service-client: бины WalletsApi, TransactionsApi на transactionWebClient", "Ставит X-User-Uid, переводит ошибки: 400/404/409 пробрасывает, 5xx и таймаут -> 503")
    Component(keycloakClient, "KeycloakClient", "адаптер на WebClient", "Admin-вызовы, вход по паролю, refresh, откат недоделанного аккаунта")
    Component(errors, "GlobalExceptionHandler, SecurityErrorWriter", "обработка ошибок", "Любая ошибка — один ErrorResponseDto с traceId")
    Component(metrics, "AuthMetrics", "Micrometer", "Метрики регистрации, входа и зависимостей")
}

Rel(client, filter, "REST /api/v1/auth, /api/v1/wallets, /api/v1/transactions", "HTTP, JSON")
Rel(filter, security, "передаёт запрос")
Rel(security, controller, "аутентифицирован или открытый путь")
Rel(security, walletController, "только аутентифицирован")
Rel(security, transactionController, "только аутентифицирован")
Rel(controller, validation, "@Valid")
Rel(controller, userService, "вызывает")
Rel(walletController, walletService, "запрос + Jwt")
Rel(transactionController, transactionService2, "запрос + Jwt")
Rel(userService, personClient, "создание, компенсация")
Rel(userService, keycloakClient, "аккаунт, пароль, роль")
Rel(userService, tokenService, "токены")
Rel(tokenService, keycloakClient, "вход, refresh")
Rel(walletService, transactionClient, "user_uid + запрос")
Rel(transactionService2, transactionClient, "user_uid + запрос")
Rel(personClient, personService, "REST /api/v1/individuals", "HTTP")
Rel(transactionClient, transactionService, "REST /api/v1/wallets, /api/v1/transactions + X-User-Uid", "HTTP")
Rel(keycloakClient, keycloak, "admin REST, выдача токенов", "HTTP")
Rel(security, keycloak, "JWKS", "HTTP")
Rel_Back(errors, controller, "ApiException и ошибки фреймворка")
Rel(metrics, observability, "метрики и спаны", "/actuator/prometheus, OTLP")

SHOW_LEGEND()
@enduml
